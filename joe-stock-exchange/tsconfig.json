{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@joese/contracts": ["packages/contracts/src/index.ts"],
      "@joese/market-rules": ["packages/market-rules/src/index.ts"],
      "@joese/ui": ["packages/ui/src/index.ts"]
    }
  }
}

