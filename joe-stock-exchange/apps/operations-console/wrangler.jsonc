{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "joese-operations-console",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "routes": [
    { "pattern": "joese-console.derekli.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}

