{
  "name": "@joese/exchange-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --persist-to ../../.wrangler/state",
    "build": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "deploy": "node ../../scripts/check-worker-config.mjs && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@joese/contracts": "*",
    "@joese/market-rules": "*"
  }
}

