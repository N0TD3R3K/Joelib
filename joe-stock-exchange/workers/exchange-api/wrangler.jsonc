{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "joese-exchange-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "upload_source_maps": true,
  "workers_dev": false,
  "routes": [
    { "pattern": "api.joese.derekli.dev", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_EMAIL_DOMAINS": "sstx.org,hamdenhall.org",
    "ALLOWED_ORIGINS": "https://joese.derekli.dev,https://joese-console.derekli.dev",
    "REQUIRE_INVITE": "true",
    "ENFORCE_TRADING_SCHEDULE": "true",
    "RESEND_FROM_EMAIL": "JOESE <noreply@joese.derekli.dev>",
    "JOE_BANK_MAX_LOAN_CENTS": "1000000",
    "JOE_BANK_DEFAULT_RATE_BPS": "800",
    "JOE_BANK_MAX_RATE_BPS": "5000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joese",
      "database_id": "01dc7c78-f63d-4491-adb4-0bb692b6c0a3",
      "migrations_dir": "../../database/migrations"
    }
  ],
  "observability": { "enabled": true }
}

