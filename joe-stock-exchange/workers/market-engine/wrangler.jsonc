{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "joese-market-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "upload_source_maps": true,
  "workers_dev": false,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joese",
      "database_id": "01dc7c78-f63d-4491-adb4-0bb692b6c0a3",
      "migrations_dir": "../../database/migrations"
    }
  ],
  "observability": { "enabled": true }
}

