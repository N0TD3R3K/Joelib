{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joelang-studio",
  "main": "./cloudflare/src/worker.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "joelang-studio.derekli.dev",
      "custom_domain": true
    }
  ]
}
