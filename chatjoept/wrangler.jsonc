/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "51a849fd51f1774937bb4155db033c92",
	"name": "chatjoept",
	"compatibility_date": "2026-11-04",
	"main": "./workers/app.ts",
	"vars": {
		"LLM_API_URL": "https://api.deepseek.com",
		"LLM_BASE_MODEL": "deepseek-chat",
		"JOEAUTH_ISSUER": "https://auth.joe-univer.se",
		"CANONICAL_ORIGIN": ""
	},
	"d1_databases": [
		{
			"binding": "CHATJOEPT_DB",
			"database_name": "chatjoept-db",
			"database_id": "1ca84d39-9bb3-4c78-98c2-e7e506310955",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
